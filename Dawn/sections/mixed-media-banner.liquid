{% comment %}
  Adds up to three banners to each PDP. Can be generic content if filled in directly, or connected to product-level banner image, title & text metafields.
  Each block will only load if its image has been populated. Titles & text are optional.
  Setting a block to Background will create a full-width background image with the optional title & text centered.
  Blocks can also be set to Image on Left or Image on Right, for a two-column, 50/50 display. On mobile these will always stack with the image first.
{% endcomment %}

{%- style -%}

 .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  } 

{%- endstyle -%}

  <div class="mixed-media-banners color-{{ section.settings.color_scheme }} gradient">
    <div class="mixed-media-banners__inner page-width section-{{ section.id }}-padding">
      <div class="mixed-media-banners__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            {%- assign alt_text = block.settings.title -%}
            {%- assign layout = block.settings.layout -%}
            {%- assign item_class = 'mixed-media-banners__item mixed-media-banners__item--' | append: layout -%}
            <div class="content-block {{ item_class }}">
              <div class="mixed-media-banners__media">
                {%- if layout == 'background' -%}
                  {{ block.settings.image | image_url: width: 3200 | image_tag: sizes: '2400', widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400, 2800, 3200', alt: alt_text }}
                {%- else -%}
                  {{ block.settings.image | image_url: width: 1600 | image_tag: sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1000, 1200, 1600', alt: alt_text }}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank or block.settings.text != blank -%}
                <div class="mixed-media-banners__content">
                  {%- if block.settings.title != blank -%}
                    <{{ block.settings.heading_tag }} class="mixed-media-banners__title" style="color: {{ block.settings.color }}">
                      {{ block.settings.title }}
                    </{{ block.settings.heading_tag }}>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <p class="mixed-media-banners__text" style="color: {{ block.settings.color }}">
                      {{ block.settings.text }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%} 
      </div>
    </div>
  </div>

{% schema %}
{
  "name": "Mixed-media banners",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "background", "label": "Background" },
            { "value": "left", "label": "Image On Left" },
            { "value": "right", "label": "Image On Right" }
          ],
          "default": "background"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading level",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Title & text color",
          "default": "#000000"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Mixed-media banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}